Shell command: 
        (
            before_count=$(bcftools view -H work/cohort/cohort.vcf.gz | wc -l | tr -d ' ')

            gatk VariantFiltration \
                -R /courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa \
                -V work/cohort/cohort.vcf.gz \
                -O results-smk/cohort.filtered.vcf.gz \
                --filter-expression "QD < 2.0" \
                --filter-name "QD2" \
                --filter-expression "QUAL < 30.0" \
                --filter-name "QUAL30"

            after_count=$(bcftools view -H results-smk/cohort.filtered.vcf.gz | wc -l | tr -d ' ')

            if [[ "$before_count" != "$after_count" ]]; then
                echo "VariantFiltration changed record count" >&2
                exit 1
            fi

            printf 'chrom\tpos\tref\talt\tqual\tfilter\n' > results-smk/variants.tsv

            bcftools query \
                -f '%CHROM\t%POS\t%REF\t%ALT\t%QUAL\t%FILTER\n' \
                results-smk/cohort.filtered.vcf.gz >> results-smk/variants.tsv
        ) > logs/filter.log 2>&1
        
